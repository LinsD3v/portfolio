---
import { siteConfig } from '../config/site';

const {
  title,
  description,
  pathname = '/',
  image = '',
} = Astro.props;

const pageTitle = title || siteConfig.title;
const pageDescription = description || siteConfig.description;
const canonical = siteConfig.baseUrl ? new URL(pathname, siteConfig.baseUrl).toString() : undefined;
const openGraphImage = image || siteConfig.openGraphImage;
const ogImage = openGraphImage && siteConfig.baseUrl ? new URL(openGraphImage, siteConfig.baseUrl).toString() : openGraphImage;
---
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<meta name="robots" content={siteConfig.robots} />
{canonical ? <link rel="canonical" href={canonical} /> : null}
<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
{canonical ? <meta property="og:url" content={canonical} /> : null}
{ogImage ? <meta property="og:image" content={ogImage} /> : null}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="theme-color" content="#0B0F10" />
