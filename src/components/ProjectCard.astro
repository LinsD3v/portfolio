---
const { project } = Astro.props;
const statusLabel = {
  experimental: 'Experimental',
  'in-development': 'Em desenvolvimento',
  concluded: 'Concluído',
}[project.data.status || 'experimental'];
---
<article class="card">
  <div class="card-top">
    <span class="badge">{statusLabel}</span>
    {project.data.featured ? <span class="badge accent">Destaque</span> : null}
  </div>
  <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
  <p>{project.data.description}</p>
  <ul class="tag-list">
    {(project.data.tags || []).slice(0, 3).map((tag) => <li>{tag}</li>)}
  </ul>
  <div class="card-actions">
    <a href={`/projects/${project.id}/`} class="button secondary">Ver estudo de caso</a>
    {project.data.repoUrl ? <a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">Repositório</a> : null}
  </div>
</article>
